# Copy to apps/api/.env and fill in. Never commit .env.

# PostgreSQL connection string (matches docker-compose.yml for local dev)
DATABASE_URL=postgresql://taxiflow:taxiflow@localhost:5432/taxiflow?schema=public

# Long random string used to sign JWTs, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# URL of the web app. Comma-separate several origins if needed.
CORS_ORIGIN=http://localhost:3000

# Port for the API and Socket.IO server
PORT=4000

# true only for the demo: switches on POST /dev/reset and GET /dev/sms
DEMO_MODE=true

# Priority assistance follows each station's agreed policy (default true)
PRIORITY_ENABLED=true
